<UserControl x:Class="Presentation.Shell.Views.UserControls.SettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:dataGrids="clr-namespace:Common.WpfModule.Ui.Behaviors.DataGrids;assembly=Ui"
             xmlns:datePickers="clr-namespace:Common.WpfModule.Ui.Behaviors.DatePickers;assembly=Ui"
             xmlns:controls="clr-namespace:Common.WpfModule.Ui.Controls;assembly=Ui"
             xmlns:markups="clr-namespace:Common.WpfModule.Ui.Markups;assembly=Ui"
             xmlns:attachedProperties="clr-namespace:Common.WpfModule.Ui.AttachedProperties;assembly=Ui"
             xmlns:main="clr-namespace:Presentation.ViewModels.Main;assembly=ViewModels"
             xmlns:strictXaml="clr-namespace:StrictXAML;assembly=StrictXAML"
             xmlns:converters="clr-namespace:Common.WpfModule.Ui.Converters;assembly=Ui"
             xmlns:libraryEntities="clr-namespace:ProblemDomain.Entities.LibraryEntities;assembly=Entities"
             xmlns:models="clr-namespace:Presentation.ViewModels.Shared.Models;assembly=ViewModels"
             xmlns:textBlocks="clr-namespace:Common.WpfModule.Ui.Behaviors.TextBlocks;assembly=Ui"
             d:DataContext="{d:DesignInstance main:SettingVM}"
             mc:Ignorable="d" >

    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>
    
    <Grid >
        <Grid.RowDefinitions>
            <!-- 1️⃣ Верхняя зона - Данные о соревнованиях, Виды программ -->
            <RowDefinition Height="0.6*" MinHeight="225" /> <!-- TODO: откорректировать MinHeight -->
            
            <!-- 2️⃣ Строка для разделителя -->
            <RowDefinition Height="Auto" />
            
            <!-- 3️⃣ Нижняя зона - Судьи -->
            <RowDefinition Height="0.4*" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- 1️⃣ Верхняя зона - Данные о соревнованиях, Виды программ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 1️⃣1️⃣ Левая верхняя зона - Данные о соревнованиях -->
                <ColumnDefinition Width="4*" MinWidth="150"/>
                
                <!-- 1️⃣2️⃣ Столбец для разделителя -->
                <ColumnDefinition Width="Auto"/>
                
                <!-- 1️⃣2️⃣ Правая верхняя зона - Виды программ -->
                <ColumnDefinition Width="5*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <!-- 1️⃣1️⃣ Левая верхняя зона - Данные о соревнованиях -->
            <!-- Данные о соревнованиях -->
            <Grid Grid.Row="0">
                <Grid Style="{markups:GridColumnSpacing 10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="220" />
                        <ColumnDefinition Width="8*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />     <!-- 0. Краткое название, название соревнований - Метка -->
                        <RowDefinition Height="Auto" />     <!-- 1. Краткое название соревнований - Текстовое поле -->
                        <RowDefinition Height="Auto" />     <!-- 2. Проводящие организации - Метка -->
                        <RowDefinition MinHeight="60"/>     <!-- 3. Проводящие организации - DataGrid -->
                        <RowDefinition Height="Auto" />     <!-- 4. Дата, место проведения - Метки -->
                        <RowDefinition Height="Auto" />     <!-- 5. Дата, место проведения - DatePicker, Текстовое поле -->
                        <RowDefinition Height="Auto" />     <!-- 6. Статус и наименование соревнования - Метка -->
                        <RowDefinition Height="Auto" />     <!-- 7. Статус и наименование соревнования - Текстовое поле, Выпад. список -->
                        <RowDefinition Height="Auto" />     <!-- 8. Признак студ. соревнований - Флажок -->
                        <RowDefinition Height="Auto" />     <!-- 9. Примечание - Метка -->
                        <RowDefinition Height="Auto" />     <!-- 10. Примечание - Текстовое поле -->
                    </Grid.RowDefinitions>

                    <!-- Краткое название соревнований -->
                    <Label Grid.Row="0" Grid.Column="0" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           attachedProperties:ElementProperties.IsFirst="True"
                           Content="{DynamicResource SettingControl.CompetitionShortName}" />
                    <TextBox Grid.Row="1" Grid.Column="0" 
                             Style="{StaticResource BaseTextBox}"
                             HorizontalAlignment="Stretch"
                             Text="{Binding CurrentCompetition.ShortName, UpdateSourceTrigger=LostFocus}" />
                    
                    <!-- Название соревнований -->
                    <Label Grid.Row="0" Grid.Column="1" 
                           attachedProperties:ElementProperties.IsFirst="True"
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl.CompetitionName}" />
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Style="{StaticResource BaseTextBox}"
                             HorizontalAlignment="Stretch"
                             Text="{Binding CurrentCompetition.Competition.Name, UpdateSourceTrigger=LostFocus}" />

                    <!-- Проводящие организации -->
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl.ConductingOrganizations}" />
                    <DataGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                              x:Name="ConductingOrganizationsGrid"
                              Style="{StaticResource DataGridDefault}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDefault.ContentRight}"
                              MinColumnWidth="200"
                              AlternationCount="2"
                              AutoGenerateColumns="False"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              ItemsSource="{Binding ConductingOrganizations, 
                                Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedIndex="{Binding ConductingOrganizations.SelectedIndex, 
                                Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath=""
                              AllowDrop="True">

                        <i:Interaction.Behaviors>
                            <dataGrids:DataGridDragAndDropBehavior 
                                Items="{Binding ConductingOrganizations}"
                                AfterItemMovedCommand="{Binding RenumberConductingOrganizationsCommand}" />
                        </i:Interaction.Behaviors>

                        <DataGrid.Columns>
                            <!-- Номер -->
                            <DataGridTextColumn Width="Auto"
                                                MinWidth="30"
                                                Binding="{Binding Number}"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle.ContentCenter}">
                            </DataGridTextColumn>
                            
                            <!-- Название -->
                            <DataGridTextColumn
                                Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                CanUserSort="False"
                                Width="*"
                                ElementStyle="{StaticResource DataGridTextBlockStyle}">
                                <DataGridTextColumn.Header>
                                    <controls:DataGridColumnHeaderWithButtons
                                        Content="Действия:"
                                        IsTextOnRight="False"
                                        Style="{StaticResource DataGridColumnHeaderWithButtons}" 
                                        Button1Content="➕"
                                        Button1Command="{Binding DataContext.CreateConductingOrganizationCommand, 
                                            ElementName=ConductingOrganizationsGrid}"
                                        Button1ToolTip="{DynamicResource SettingControl.AddConductingOrganization}"
                                        Button2Content="❌"
                                        Button2Command="{Binding DataContext.RemoveConductingOrganizationCommand, 
                                            ElementName=ConductingOrganizationsGrid}"
                                        Button2ToolTip="{DynamicResource SettingControl.RemoveConductingOrganization}" />
                                    <!-- TODO: Content удалить -->
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                            
                    </DataGrid>
                    
                    <!-- Дата проведения -->
                    <Label Grid.Row="4" Grid.Column="0" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl_CompetitionDate}" />
                    <StackPanel Grid.Row="5" Grid.Column="0"
                                Orientation="Horizontal">
                        <DatePicker Width="95" 
                                    Style="{StaticResource BaseDatePicker}"
                                    SelectedDate="{Binding CurrentCompetition.InitialDate, 
                                        Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                            <i:Interaction.Behaviors>
                                <datePickers:DatePickerLocalizationBehavior LanguageTag="{Binding CurrLang.Name}" />
                            </i:Interaction.Behaviors>
                        </DatePicker>
                        <TextBlock Width="20"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="-" />
                        <DatePicker Width="95" 
                                    Style="{StaticResource BaseDatePicker}"
                                    SelectedDate="{Binding CurrentCompetition.EndDate, 
                                        Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                            <i:Interaction.Behaviors>
                                <datePickers:DatePickerLocalizationBehavior LanguageTag="{Binding CurrLang.Name}" />
                            </i:Interaction.Behaviors>
                        </DatePicker>
                    </StackPanel>

                    <!-- Место проведения -->
                    <Label Grid.Row="4" Grid.Column="1" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl_CompetitionVenue}" />
                    <TextBox Grid.Row="5" Grid.Column="1" 
                             Style="{StaticResource BaseTextBox}"
                             MinWidth="200"
                             HorizontalAlignment="Stretch"
                             Text="{Binding CurrentCompetition.Competition.Venue, UpdateSourceTrigger=LostFocus}">
                    </TextBox>

                    <!-- Статус соревнования (кратко) -->
                    <Label Grid.Row="6" Grid.Column="0" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl_CompetitionStatus}" />
                    <TextBox Grid.Row="7" Grid.Column="0" 
                             Style="{StaticResource BaseTextBox}"
                             MinWidth="200"
                             Width="Auto"
                             HorizontalAlignment="Stretch"
                             IsReadOnly="True"
                             Text="{Binding CurrentCompetition.DetailedCompetitionStatus.CompetitionsStatus.Name}">
                    </TextBox>
                    
                    <!-- Статус и наименование соревнования -->
                    <Label Grid.Row="6" Grid.Column="1" 
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl_DetailedCompetitionStatus}" />
                    <ComboBox Grid.Row="7" Grid.Column="1" 
                              Width="Auto"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource BaseComboBox}"
                              ItemsSource="{Binding Path=DataContext.DetailedCompetitionStatuses, 
                                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              SelectedItem="{Binding CurrentCompetition.DetailedCompetitionStatus, 
                                UpdateSourceTrigger=LostFocus}" />
                    
                    <!-- Признак соревнований среди студентов -->
                    <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                              Style="{StaticResource BaseCheckBox.Bold}"
                              IsChecked="{Binding CurrentCompetition.IsStudentCompetition, 
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="{DynamicResource SettingControl_IsStudentCompetition}" />

                    <!-- Примечание -->
                    <Label Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                           Content="{DynamicResource SettingControl_CompetitionNote}" />
                    <TextBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource BaseTextBox}"
                             MinWidth="200"
                             HorizontalAlignment="Stretch"
                             Text="{Binding CurrentCompetition.Competition.Description, UpdateSourceTrigger=LostFocus}">
                    </TextBox>

                </Grid>
            </Grid>

            <!-- 1️⃣2️⃣ Вертикальный разделитель -->
            <GridSplitter Grid.Column="1" 
                          Width="10" 
                          Margin="7 20 7 20"
                          HorizontalAlignment="Stretch" 
                          Background="{StaticResource DefaultLightBorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          />

            <!-- 1️⃣2️⃣ Правая верхняя зона - Виды программ -->
        <DockPanel Grid.Column="2">
            <Label DockPanel.Dock="Top" 
                   Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                   attachedProperties:ElementProperties.IsFirst="True"
                   Content="{DynamicResource SettingControl_SportEventList}" />
            <DataGrid
                      Style="{StaticResource DataGridDefault}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDefault.Bold}"
                      MinColumnWidth="70"
                      AlternationCount="2"
                      AutoGenerateColumns="False"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      ItemsSource="{Binding SportEventObservables, 
                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedIndex="{Binding SportEventObservables.SelectedIndex, 
                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AllowDrop="True" >

                <i:Interaction.Behaviors>
                    <dataGrids:DataGridDragAndDropBehavior 
                        Items="{Binding SportEventObservables}"
                        AfterItemMovedCommand="{Binding RenumberSportEventsCommand}" />
                </i:Interaction.Behaviors>
                
                <DataGrid.Columns>
                    <!-- Номер -->
                    <DataGridTextColumn
                        Header="№"
                        Width="Auto"
                        MinWidth="30"
                        Binding="{Binding Number}"
                        ElementStyle="{StaticResource DataGridTextBlockStyle.ContentCenter}">
                    </DataGridTextColumn>
                    
                    <!-- Наименование -->
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding SportEvent.Name, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_SportEventList_Name}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    
                    <!-- Дисциплина -->
                    <DataGridTemplateColumn Width="1.55*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_SportEventList_Discipline}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding Path=DataContext.AvailableDisciplines, 
                                        RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    SelectedItem="{Binding  DisplayDiscipline,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True}"
                                    BorderThickness="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Трудность -->
                    <DataGridTemplateColumn Width="0.7*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock 
                                Text="{DynamicResource SettingControl_SportEventList_Difficulty}"
                                ToolTip="{DynamicResource SettingControl_SportEventList_Difficulty_Tooltip}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding AvailableDifficulties}"
                                    SelectedItem="{Binding Difficulty, 
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, 
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True}"
                                    BorderThickness="0">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Возрастная группа -->
                    <DataGridTemplateColumn Width="1*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock 
                                Text="{DynamicResource SettingControl_SportEventList_AgeGroup}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding AvailableAgeGroups}"
                                    SelectedItem="{Binding DisplayAgeGroup, 
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, 
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True}"
                                    BorderThickness="0">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Признак короткой дистанции -->
                    <DataGridTemplateColumn Width="0.45*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_SportEventList_IsShort}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox 
                                    Style="{StaticResource CheckBoxForDataGrid}"
                                    IsThreeState="True"
                                    IsChecked="{Binding SportEvent.IsShort, 
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsShortAvailable}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Примечание -->
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding SportEvent.Description, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_SportEventList_Description}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </DockPanel>
        </Grid>
        
        <!-- 2️⃣ Горизонтальный разделитель -->
        <GridSplitter Grid.Row="1" 
                      Height="10"
                      Margin="20 7 20 0"
                      VerticalAlignment="Stretch" 
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource DefaultLightBorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>
        
        <!-- 3️⃣ Нижняя зона - Судьи -->
        <DockPanel Grid.Row="2">
            <Label DockPanel.Dock="Top" 
                   Style="{StaticResource BaseLabel.ContentLeft.Bold}"
                   Content="{DynamicResource SettingControl_RefereeList}" />
            <DataGrid
                Style="{StaticResource DataGridDefault}"
                ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDefault.Bold}"
                MinColumnWidth="70"
                AlternationCount="2"
                AutoGenerateColumns="False"
                SelectionUnit="FullRow"
                SelectionMode="Single"
                ItemsSource="{Binding RefereeObservables, 
                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedIndex="{Binding RefereeObservables.SelectedIndex, 
                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AllowDrop="True">

                <i:Interaction.Behaviors>
                    <dataGrids:DataGridDragAndDropBehavior 
                        Items="{Binding RefereeObservables}"
                        AfterItemMovedCommand="{Binding RenumberRefereesCommand}" />
                </i:Interaction.Behaviors>
                
                <DataGrid.Columns>
                    <!-- Номер -->
                    <DataGridTextColumn Header="№"
                                        Width="Auto"
                                        MinWidth="30"
                                        Binding="{Binding Number}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle.ContentCenter}">
                    </DataGridTextColumn>
                    
                    <!-- Фамилия -->
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Referee.LastName, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_LastName}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    
                    <!-- Имя -->
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Referee.FirstName, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_FirstName}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    
                    <!-- Отчество -->
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Referee.Patronymic, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_Patronymic}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    
                    <!-- Территория -->
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Referee.Domicile, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_Domicile}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    
                    <!-- Судейская категория -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_Category}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding Path=AvailableCategories}"
                                    SelectedItem="{Binding CategoryObservable,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Center">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               d:DataContext="{d:DesignInstance models:RefereeCategoryObservable}">
                                            <Setter Property="IsEnabled" 
                                                    Value="{Binding IsAvailable}" />
                                            <Setter Property="Opacity"
                                                    Value="{Binding IsAvailable,
                                                    Converter={StaticResource BoolToOpacityConverter}}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Дата присвоения/подтверждения -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_CategoryGrantedDate}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CategoryGrantedDate, StringFormat={}{0:d}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <i:Interaction.Behaviors>
                                        <textBlocks:TextBlockLocalizationBehavior
                                            LanguageTag="{Binding DataContext.CurrLang.Name, 
                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker
                                    Style="{StaticResource BaseDatePicker}"
                                    SelectedDate="{Binding CategoryGrantedDate, 
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center">
                                    <i:Interaction.Behaviors>
                                        <datePickers:DatePickerLocalizationBehavior
                                            LanguageTag="{Binding DataContext.CurrLang.Name, 
                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </i:Interaction.Behaviors>
                                </DatePicker>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Признак судейской категории, у которой срок действия истёк -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_IsCategoryExpired}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox 
                                    Style="{StaticResource CheckBoxForDataGrid}"
                                    IsHitTestVisible="False"
                                    Focusable="False"
                                    IsThreeState="True"
                                    IsChecked="{Binding IsCategoryExpired, 
                                        Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Должность -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_Role}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding Path=AvailableRoles}"
                                    SelectedItem="{Binding RoleObservable,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged
                                        }" 
                                    BorderThickness="0"
                                    MaxDropDownHeight="Auto" >
                                    <!--ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True-->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               d:DataContext="{d:DesignInstance models:RefereeRoleObservable}">
                                            <Setter Property="IsEnabled" 
                                                    Value="{Binding IsAvailable}" />
                                            <Setter Property="Opacity"
                                                    Value="{Binding IsAvailable,
                                                    Converter={StaticResource BoolToOpacityConverter}}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Примечание -->
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding Referee.Description, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource SettingControl_RefereeList_Description}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
