<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- _______________ БАЗОВЫЙ ФЛАЖОК _______________ -->
    <!-- Стиль -->
    <Style x:Key="BaseCheckBox" 
           TargetType="{x:Type CheckBox}">
        <Setter Property="Margin" Value="0 10 0 0" />

        <!-- Для четкой границы -->
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    
    <!-- _______________ ФЛАЖОК, ЖИРНЫЙ ТЕКСТ _______________ -->
    <!-- Стиль -->
    <Style x:Key="BaseCheckBox.Bold" 
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaseCheckBox}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <!-- _______________ ФЛАЖОК для внедрения в DataGrid _______________ -->
    <!-- Стиль -->
    <Style x:Key="CheckBoxForDataGrid"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource BaseCheckBox}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>


</ResourceDictionary>